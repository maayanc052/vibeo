# ========== Vibeo — משתני סביבה ==========
# העתיקו לקובץ .env.local ומלאו ערכים. לעולם אל תבצעו commit לסודות.

# --- כללי ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (אימייל / OTP / תזכורות) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- סליקה: mock | payplus | grow | meshulam ---
PAYMENT_GATEWAY=mock
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
GROW_API_KEY=
GROW_USER_ID=
GROW_PAGE_CODE=

# --- AI Event Generator ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- אבטחה ---
CRON_SECRET=
QR_SIGNING_SECRET=

# --- נכסים ---
# כתובת לסרטון רקע ללא תמלוגים (Pexels / Pixabay / Unsplash)
NEXT_PUBLIC_HERO_VIDEO_URL=
